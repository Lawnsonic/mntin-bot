# ============================================================================
# Environment Configuration Example
# Copy this file to `.env` and fill in your real values.
#   cp env.example .env
# ============================================================================

# --- Telegram Bot -----------------------------------------------------------
# Bot token from BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Encryption Key ---------------------------------------------------------
# Fernet key for encrypting stored user wallet private keys.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# --- Network RPCs (HTTP) ----------------------------------------------------
# Robinhood Chain (default). Chain ID 4663, built on Arbitrum Orbit.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# Other supported chains (Alchemy HTTPS recommended for sub-100ms latency)
ARB_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Network RPCs (WebSocket) -----------------------------------------------
# One WebSocket endpoint per chain. Required for mempool sniper.
# Alchemy encodes the chain in the subdomain. You need a separate key per chain.
ROBINHOOD_WS_RPC=wss://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
ARB_WS_RPC=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_WS_RPC=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_WS_RPC=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Safety & Strategy ------------------------------------------------------
# Maximum base fee allowed (in GWEI) before refusing to transact
MAX_BASE_FEE_GWEI=100

# Maximum ETH spend limit per day (per user, for sniper)
DAILY_LIMIT_ETH=0.05

# --- Admin & Persistence -----------------------------------------------------
# Comma-separated Telegram user IDs allowed to run /restore_db.
# Leave blank to disable the command entirely.
ADMIN_USER_IDS=

# Directory where users.db lives. Point this at a mounted Railway Volume
# (e.g. /data) so the database survives redeploys.
DATA_DIR=
