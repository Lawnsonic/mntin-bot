# ============================================================================
# Environment Configuration Example
# Copy this file to `.env` and fill in your real values.
#   cp env.example .env
# ============================================================================

# --- Telegram Bot -----------------------------------------------------------
# Bot token from BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Encryption Key ---------------------------------------------------------
# Fernet key for encrypting stored user wallet private keys.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# --- Network RPCs -----------------------------------------------------------
# Robinhood Chain (default) — chain ID 4663, built on Arbitrum Orbit
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# Other supported chains
ARB_RPC=https://arb1.arbitrum.io/rpc
BASE_RPC=https://mainnet.base.org
ETH_RPC=https://eth.llamarpc.com

# WebSocket RPC for mempool sniper (e.g. Alchemy)
WS_RPC=wss://your-ws-endpoint-here

# --- Safety & Strategy ------------------------------------------------------
# Maximum base fee allowed (in GWEI) before refusing to transact
MAX_BASE_FEE_GWEI=100

# Maximum ETH spend limit per day (per user, for sniper)
DAILY_LIMIT_ETH=0.05
