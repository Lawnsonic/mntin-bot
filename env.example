# ============================================================================
# Environment Configuration Example
# Copy this file to `.env` and fill in your real values.
#   cp env.example .env
# ============================================================================

# --- Telegram Bot -----------------------------------------------------------
# Bot token from BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram user ID allowed to control the bot
ALLOWED_USER_ID=your_telegram_user_id

# --- RPC Endpoints ----------------------------------------------------------
# HTTP RPC endpoint for the network (e.g. https://mainnet.base.org)
HTTP_RPC=https://mainnet.base.org

# WebSocket RPC endpoint for real-time updates
WS_RPC=wss://mainnet.base.org

# --- Wallet -----------------------------------------------------------------
# Private key of the wallet used to send transactions (keep this secret!)
PRIVATE_KEY=your_private_key_here

# Target wallet to monitor for sniper functionality
TARGET_WALLET=0x0000000000000000000000000000000000000000

# --- Trading / Gas Settings ---------------------------------------------------
# Maximum base fee allowed (in GWEI) before refusing to transact
MAX_BASE_FEE_GWEI=150

# Maximum ETH spend limit per day
DAILY_LIMIT_ETH=5.0
